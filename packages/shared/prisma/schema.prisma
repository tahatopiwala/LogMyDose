// Prisma Schema for BioStak
// The biohacker's health tracking tool

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// =============================================================================
// PATIENTS (D2C Users)
// =============================================================================

model Patient {
  id                   String    @id @default(uuid()) @db.Uuid
  email                String    @unique @db.VarChar(255)
  passwordHash         String    @map("password_hash") @db.VarChar(255)
  firstName            String?   @map("first_name") @db.VarChar(100)
  lastName             String?   @map("last_name") @db.VarChar(100)
  dateOfBirth          DateTime? @map("date_of_birth") @db.Date
  phone                String?   @db.VarChar(20)

  // D2C subscription
  subscriptionTier     String?   @map("subscription_tier") @db.VarChar(50) // free, pro
  subscriptionStatus   String?   @map("subscription_status") @db.VarChar(50)
  stripeCustomerId     String?   @map("stripe_customer_id") @db.VarChar(255)
  stripeSubscriptionId String?   @map("stripe_subscription_id") @db.VarChar(255)
  subscriptionPeriodEnd DateTime? @map("subscription_period_end")
  subscriptionPriceId  String?   @map("subscription_price_id") @db.VarChar(255)
  trialEndsAt          DateTime? @map("trial_ends_at")
  cancelAtPeriodEnd    Boolean   @default(false) @map("cancel_at_period_end")

  settings             Json?
  tokenVersion         Int       @default(0) @map("token_version")
  emailVerifiedAt      DateTime? @map("email_verified_at")
  deletedAt            DateTime? @map("deleted_at")
  createdAt            DateTime  @default(now()) @map("created_at")

  // Relations
  emailVerificationTokens EmailVerificationToken[]
  protocols            Protocol[]
  doses                Dose[]
  sideEffects          SideEffect[]
  biometricEntries     BiometricEntry[]
  progressEntries      ProgressEntry[]
  alerts               Alert[]
  aiInsights           AiInsight[]
  aiAnnotations        AiAnnotation[]
  aiReports            AiReport[]
  customProducts       Product[]
  exportJobs           ExportJob[]
  vials                Vial[]
  cycles               Cycle[]
  titrationPhases      TitrationPhase[]

  @@map("patients")
}

model EmailVerificationToken {
  id        String    @id @default(uuid()) @db.Uuid
  patientId String    @map("patient_id") @db.Uuid
  token     String    @unique @db.VarChar(255)
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  // Relations
  patient   Patient   @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@index([token])
  @@index([patientId])
  @@map("email_verification_tokens")
}

// PDF Export Jobs - track async export requests
model ExportJob {
  id         String    @id @default(uuid()) @db.Uuid
  patientId  String    @map("patient_id") @db.Uuid
  patient    Patient   @relation(fields: [patientId], references: [id], onDelete: Cascade)

  status     String    @default("pending") @db.VarChar(50) // pending, processing, completed, failed
  startDate  DateTime  @map("start_date") @db.Date
  endDate    DateTime  @map("end_date") @db.Date

  fileUrl    String?   @map("file_url") @db.VarChar(1024) // S3 URL when completed
  fileName   String?   @map("file_name") @db.VarChar(255) // Original filename
  fileSize   Int?      @map("file_size") // Size in bytes

  error      String?   @db.Text // Error message if failed
  attempts   Int       @default(0)

  expiresAt  DateTime  @map("expires_at") // Auto-cleanup after 7 days
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")

  @@index([patientId, status])
  @@index([expiresAt])
  @@map("export_jobs")
}

// =============================================================================
// SUBSTANCES & PROTOCOLS
// =============================================================================

// Substance categories (extensible for future verticals)
model SubstanceCategory {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @db.VarChar(100) // peptide, hormone, supplement, nootropic, medication
  displayName String   @map("display_name") @db.VarChar(100)
  description String?  @db.Text
  icon        String?  @db.VarChar(50)
  isActive    Boolean  @default(true) @map("is_active")
  sortOrder   Int      @default(0) @map("sort_order")
  createdAt   DateTime @default(now()) @map("created_at")

  // Relations
  substances        Substance[]
  protocolTemplates ProtocolTemplate[]

  @@map("substance_categories")
}

// Substances database (peptides, hormones, supplements, etc.)
model Substance {
  id                          String   @id @default(uuid()) @db.Uuid
  categoryId                  String   @map("category_id") @db.Uuid
  name                        String   @db.VarChar(100)
  aliases                     String[] // alternative names
  subcategory                 String?  @db.VarChar(100) // healing, gh_secretagogue, vitamin, etc.

  // Dosing info
  defaultDose                 Decimal? @map("default_dose")
  doseUnit                    String?  @map("dose_unit") @db.VarChar(20) // mcg, mg, ml, iu, capsule
  defaultFrequency            String?  @map("default_frequency") @db.VarChar(50)

  // Administration
  administrationRoute         String?  @map("administration_route") @db.VarChar(50) // injection_subq, injection_im, oral, topical, sublingual
  preparationInstructions     String?  @map("preparation_instructions") @db.Text

  // Storage
  storageTemp                 String?  @map("storage_temp") @db.VarChar(50)
  storageNotes                String?  @map("storage_notes") @db.Text
  shelfLifeDays               Int?     @map("shelf_life_days")
  shelfLifeReconstitutedDays  Int?     @map("shelf_life_reconstituted_days")

  // Cycling (optional)
  requiresCycling             Boolean  @default(false) @map("requires_cycling")
  commonCycleOnWeeks          Int?     @map("common_cycle_on_weeks")
  commonCycleOffWeeks         Int?     @map("common_cycle_off_weeks")

  // Safety info
  contraindications           String[]
  commonSideEffects           String[] @map("common_side_effects")
  interactions                String[]
  onsetTimeline               String?  @map("onset_timeline") @db.VarChar(100)

  // FDA & Regulatory Info
  fdaStatus                   String?  @map("fda_status") @db.VarChar(50) // approved, research, supplement, withdrawn
  fdaApprovedFor              String[] @map("fda_approved_for") // Approved indications
  fdaLabelUrl                 String?  @map("fda_label_url") @db.VarChar(500) // Link to FDA drug label (DailyMed)
  references                  Json?    // Array of {title, url, type} for studies, FDA docs, etc.

  // Metadata
  isPrescriptionRequired      Boolean  @default(false) @map("is_prescription_required")
  isActive                    Boolean  @default(true) @map("is_active")
  createdAt                   DateTime @default(now()) @map("created_at")

  // Relations
  category                    SubstanceCategory    @relation(fields: [categoryId], references: [id])
  protocolTemplates           ProtocolTemplate[]
  protocolSubstances          ProtocolSubstance[]
  doses                       Dose[]
  sideEffects                 SideEffect[]
  products                    Product[]

  @@map("substances")
}

// Products - branded versions of substances (e.g., "Ozempic 0.25mg" for Semaglutide)
model Product {
  id            String    @id @default(uuid()) @db.Uuid
  substanceId   String    @map("substance_id") @db.Uuid
  name          String    @db.VarChar(255)
  defaultDose   Decimal?  @map("default_dose")
  doseUnit      String?   @map("dose_unit") @db.VarChar(20)
  isGlobal      Boolean   @default(false) @map("is_global")
  patientId     String?   @map("patient_id") @db.Uuid
  isActive      Boolean   @default(true) @map("is_active")
  createdAt     DateTime  @default(now()) @map("created_at")

  // Relations
  substance          Substance           @relation(fields: [substanceId], references: [id])
  patient            Patient?            @relation(fields: [patientId], references: [id])
  protocolSubstances ProtocolSubstance[]
  doses              Dose[]
  vials              Vial[]

  @@index([substanceId])
  @@index([patientId])
  @@index([isGlobal])
  @@map("products")
}

// Vials - track individual vials with reconstitution and inventory
model Vial {
  id                   String    @id @default(uuid()) @db.Uuid
  patientId            String    @map("patient_id") @db.Uuid
  productId            String    @map("product_id") @db.Uuid

  // Reconstitution details
  reconstitutedAt      DateTime? @map("reconstituted_at")
  diluentType          String?   @map("diluent_type") @db.VarChar(50) // bacteriostatic_water, saline, sterile_water
  diluentVolumeMl      Decimal?  @map("diluent_volume_ml")
  concentrationMcgMl   Decimal?  @map("concentration_mcg_ml") // Calculated: vialAmountMcg / diluentVolumeMl

  // Vial contents
  vialAmountMcg        Decimal?  @map("vial_amount_mcg") // Original amount in vial
  remainingAmountMcg   Decimal?  @map("remaining_amount_mcg") // Decremented as doses are logged

  // Lot/batch tracking
  lotNumber            String?   @map("lot_number") @db.VarChar(100)
  manufacturerExpDate  DateTime? @map("manufacturer_exp_date") @db.Date // Manufacturer expiration
  calculatedExpDate    DateTime? @map("calculated_exp_date") @db.Date // Based on reconstitution + shelf life

  // Storage
  storageLocation      String?   @map("storage_location") @db.VarChar(100) // home_fridge, travel_cooler, etc.
  requiresRefrigeration Boolean  @default(true) @map("requires_refrigeration")

  // Status
  status               String    @default("active") @db.VarChar(50) // active, depleted, expired, disposed
  depletedAt           DateTime? @map("depleted_at")

  notes                String?   @db.Text
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")

  // Relations
  patient              Patient   @relation(fields: [patientId], references: [id])
  product              Product   @relation(fields: [productId], references: [id])
  doses                Dose[]

  @@index([patientId])
  @@index([productId])
  @@index([status])
  @@map("vials")
}

// Protocol templates (public library)
model ProtocolTemplate {
  id              String    @id @default(uuid()) @db.Uuid
  name            String    @db.VarChar(255)
  description     String?   @db.Text
  categoryId      String?   @map("category_id") @db.Uuid
  substanceId     String?   @map("substance_id") @db.Uuid
  defaultDose     Decimal?  @map("default_dose")
  doseUnit        String?   @map("dose_unit") @db.VarChar(20)
  frequency       String?   @db.VarChar(50)
  titrationPlan   Json?     @map("titration_plan")
  cycleOnWeeks    Int?      @map("cycle_on_weeks")
  cycleOffWeeks   Int?      @map("cycle_off_weeks")
  difficultyLevel String?   @map("difficulty_level") @db.VarChar(50) // beginner, intermediate, advanced
  tags            String[]
  useCount        Int       @default(0) @map("use_count")
  isPublic        Boolean   @default(true) @map("is_public")
  createdAt       DateTime  @default(now()) @map("created_at")

  // Relations
  category        SubstanceCategory? @relation(fields: [categoryId], references: [id])
  substance       Substance?         @relation(fields: [substanceId], references: [id])
  protocols       Protocol[]

  @@map("protocol_templates")
}

// Patient protocols (user's active protocols)
model Protocol {
  id              String    @id @default(uuid()) @db.Uuid
  patientId       String    @map("patient_id") @db.Uuid
  name            String?   @db.VarChar(255)
  description     String?   @db.Text

  // Source tracking
  source          String    @db.VarChar(50) // template, custom
  templateId      String?   @map("template_id") @db.Uuid

  status          String    @default("active") @db.VarChar(50) // draft, active, paused, completed, archived
  startDate       DateTime? @map("start_date") @db.Date
  endDate         DateTime? @map("end_date") @db.Date
  notes           String?   @db.Text
  createdAt       DateTime  @default(now()) @map("created_at")

  // Relations
  patient         Patient           @relation(fields: [patientId], references: [id])
  template        ProtocolTemplate? @relation(fields: [templateId], references: [id])
  substances      ProtocolSubstance[]

  @@map("protocols")
}

// Protocol substances (many-to-many with dosing details)
model ProtocolSubstance {
  id                   String    @id @default(uuid()) @db.Uuid
  protocolId           String    @map("protocol_id") @db.Uuid
  substanceId          String    @map("substance_id") @db.Uuid
  productId            String?   @map("product_id") @db.Uuid
  dose                 Decimal
  doseUnit             String?   @map("dose_unit") @db.VarChar(20)
  frequency            String?   @db.VarChar(50) // daily, 2x_daily, 3x_weekly, etc.
  schedule             Json?     // specific days/times
  titrationPlan        Json?     @map("titration_plan") // week-by-week dose changes
  cycleOnWeeks         Int?      @map("cycle_on_weeks")
  cycleOffWeeks        Int?      @map("cycle_off_weeks")

  // Inventory tracking
  currentSupplyAmount  Decimal?  @map("current_supply_amount")
  supplyUnit           String?   @map("supply_unit") @db.VarChar(20)
  supplyExpirationDate DateTime? @map("supply_expiration_date") @db.Date

  notes                String?   @db.Text

  // Relations
  protocol             Protocol  @relation(fields: [protocolId], references: [id], onDelete: Cascade)
  substance            Substance @relation(fields: [substanceId], references: [id])
  product              Product?  @relation(fields: [productId], references: [id])
  doses                Dose[]
  cycles               Cycle[]
  titrationPhases      TitrationPhase[]

  @@map("protocol_substances")
}

// =============================================================================
// TRACKING (Doses, Side Effects, Progress)
// =============================================================================

model Dose {
  id                   String    @id @default(uuid()) @db.Uuid
  patientId            String    @map("patient_id") @db.Uuid
  protocolSubstanceId  String?   @map("protocol_substance_id") @db.Uuid // Nullable for ad-hoc logging
  substanceId          String    @map("substance_id") @db.Uuid
  productId            String?   @map("product_id") @db.Uuid
  vialId               String?   @map("vial_id") @db.Uuid // Track which vial this dose came from
  dose                 Decimal
  doseUnit             String?   @map("dose_unit") @db.VarChar(20)
  scheduledAt          DateTime? @map("scheduled_at")
  loggedAt             DateTime  @default(now()) @map("logged_at")
  status               String    @default("taken") @db.VarChar(50) // taken, missed, skipped
  administrationSite   String?   @map("administration_site") @db.VarChar(50) // injection site
  notes                String?   @db.Text
  photoUrl             String?   @map("photo_url") @db.VarChar(500)

  // Dose context fields
  fastingState         String?   @map("fasting_state") @db.VarChar(20) // fasted, fed, unknown
  takenWithFood        Boolean?  @map("taken_with_food")
  mealFatContent       String?   @map("meal_fat_content") @db.VarChar(20) // none, low, medium, high
  timeOfDay            String?   @map("time_of_day") @db.VarChar(20) // morning, afternoon, evening, night
  needleGauge          String?   @map("needle_gauge") @db.VarChar(10) // 25g, 27g, 29g, 30g, 31g
  injectionDepth       String?   @map("injection_depth") @db.VarChar(20) // subcutaneous, intramuscular

  // Relations
  patient              Patient            @relation(fields: [patientId], references: [id])
  protocolSubstance    ProtocolSubstance? @relation(fields: [protocolSubstanceId], references: [id], onDelete: SetNull)
  substance            Substance          @relation(fields: [substanceId], references: [id])
  product              Product?           @relation(fields: [productId], references: [id])
  vial                 Vial?              @relation(fields: [vialId], references: [id])
  sideEffects          SideEffect[]
  biometricEntries     BiometricEntry[]

  @@index([vialId])
  @@map("doses")
}

model SideEffect {
  id            String   @id @default(uuid()) @db.Uuid
  patientId     String   @map("patient_id") @db.Uuid
  doseId        String?  @map("dose_id") @db.Uuid
  substanceId   String?  @map("substance_id") @db.Uuid
  symptom       String   @db.VarChar(100)
  severity      Int      // 1-10
  durationHours Decimal? @map("duration_hours")
  notes         String?  @db.Text
  reportedAt    DateTime @default(now()) @map("reported_at")

  // Relations
  patient       Patient    @relation(fields: [patientId], references: [id])
  dose          Dose?      @relation(fields: [doseId], references: [id])
  substance     Substance? @relation(fields: [substanceId], references: [id])

  @@map("side_effects")
}

model BiometricEntry {
  id          String   @id @default(uuid()) @db.Uuid
  patientId   String   @map("patient_id") @db.Uuid
  doseId      String?  @map("dose_id") @db.Uuid

  // Metric data
  metricType  String   @map("metric_type") @db.VarChar(50) // weight, blood_glucose, blood_pressure_systolic, blood_pressure_diastolic, sleep_quality, energy_level, appetite_level, pain_level, mood, heart_rate, body_fat_percentage, etc.
  value       Decimal
  unit        String?  @db.VarChar(20) // kg, lbs, mg/dL, mmol/L, bpm, %, etc.

  notes       String?  @db.Text
  recordedAt  DateTime @default(now()) @map("recorded_at")
  createdAt   DateTime @default(now()) @map("created_at")

  // Relations
  patient     Patient  @relation(fields: [patientId], references: [id])
  dose        Dose?    @relation(fields: [doseId], references: [id])

  @@index([patientId])
  @@index([metricType])
  @@index([recordedAt])
  @@index([doseId])
  @@map("biometric_entries")
}

model ProgressEntry {
  id               String   @id @default(uuid()) @db.Uuid
  patientId        String   @map("patient_id") @db.Uuid
  type             String   @db.VarChar(50) // photo, bloodwork, measurement
  data             Json?    // flexible storage for different types
  fileUrls         String[] @map("file_urls")
  notes            String?  @db.Text
  recordedAt       DateTime @default(now()) @map("recorded_at")

  // Relations
  patient          Patient  @relation(fields: [patientId], references: [id])

  @@map("progress_entries")
}

// Cycle tracking for substances that require on/off periods
model Cycle {
  id                   String    @id @default(uuid()) @db.Uuid
  patientId            String    @map("patient_id") @db.Uuid
  protocolSubstanceId  String    @map("protocol_substance_id") @db.Uuid

  cycleNumber          Int       @map("cycle_number")
  startDate            DateTime  @map("start_date") @db.Date
  endDate              DateTime? @map("end_date") @db.Date

  onWeeks              Int       @map("on_weeks")
  offWeeks             Int       @map("off_weeks")

  status               String    @default("on") @db.VarChar(20) // on, off, completed
  currentWeek          Int       @default(1) @map("current_week")

  notes                String?   @db.Text
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")

  // Relations
  patient              Patient           @relation(fields: [patientId], references: [id])
  protocolSubstance    ProtocolSubstance @relation(fields: [protocolSubstanceId], references: [id], onDelete: Cascade)

  @@index([patientId])
  @@index([protocolSubstanceId])
  @@index([status])
  @@map("cycles")
}

// Titration tracking for dose escalation (GLP-1s like Semaglutide, Tirzepatide)
model TitrationPhase {
  id                   String    @id @default(uuid()) @db.Uuid
  patientId            String    @map("patient_id") @db.Uuid
  protocolSubstanceId  String    @map("protocol_substance_id") @db.Uuid

  phaseNumber          Int       @map("phase_number")
  doseAmount           Decimal   @map("dose_amount")
  doseUnit             String    @map("dose_unit") @db.VarChar(20)

  startDate            DateTime  @map("start_date") @db.Date
  endDate              DateTime? @map("end_date") @db.Date
  weeksAtDose          Int       @map("weeks_at_dose")

  // Why this phase was created
  reason               String    @db.VarChar(50) // scheduled, tolerability, side_effects, plateau, custom
  status               String    @default("active") @db.VarChar(20) // active, completed, skipped

  // Target dose info (for tracking progress toward maintenance)
  targetDose           Decimal?  @map("target_dose")
  isMaintenancePhase   Boolean   @default(false) @map("is_maintenance_phase")

  notes                String?   @db.Text
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")

  // Relations
  patient              Patient           @relation(fields: [patientId], references: [id])
  protocolSubstance    ProtocolSubstance @relation(fields: [protocolSubstanceId], references: [id], onDelete: Cascade)

  @@index([patientId])
  @@index([protocolSubstanceId])
  @@index([status])
  @@map("titration_phases")
}

// =============================================================================
// ALERTS & NOTIFICATIONS
// =============================================================================

model Alert {
  id           String    @id @default(uuid()) @db.Uuid
  patientId    String    @map("patient_id") @db.Uuid
  type         String    @db.VarChar(50) // refill, expiration, storage, dose_reminder
  title        String?   @db.VarChar(255)
  message      String?   @db.Text
  scheduledFor DateTime? @map("scheduled_for")
  sentAt       DateTime? @map("sent_at")
  dismissedAt  DateTime? @map("dismissed_at")
  status       String    @default("pending") @db.VarChar(50)

  // Relations
  patient      Patient   @relation(fields: [patientId], references: [id])

  @@map("alerts")
}

// =============================================================================
// AI FEATURES
// =============================================================================

// Pre-generated insights for fast retrieval
model AiInsight {
  id          String    @id @default(uuid()) @db.Uuid
  patientId   String    @map("patient_id") @db.Uuid
  type        String    @db.VarChar(50) // pattern, progress, alert, optimization
  title       String    @db.VarChar(255)
  content     String    @db.Text
  actions     Json?     // available actions user can take
  priority    Int       @default(0)
  contextData Json?     @map("context_data") // data that generated this insight
  expiresAt   DateTime? @map("expires_at")
  dismissedAt DateTime? @map("dismissed_at")
  actedOnAt   DateTime? @map("acted_on_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  // Relations
  patient     Patient   @relation(fields: [patientId], references: [id])

  @@map("ai_insights")
}

// Cached annotations for viewed data
model AiAnnotation {
  id          String   @id @default(uuid()) @db.Uuid
  patientId   String   @map("patient_id") @db.Uuid
  entityType  String   @map("entity_type") @db.VarChar(50) // dose, bloodwork, progress
  entityId    String   @map("entity_id") @db.Uuid
  annotation  String   @db.Text
  createdAt   DateTime @default(now()) @map("created_at")

  // Relations
  patient     Patient  @relation(fields: [patientId], references: [id])

  @@map("ai_annotations")
}

// Generated reports
model AiReport {
  id          String   @id @default(uuid()) @db.Uuid
  patientId   String   @map("patient_id") @db.Uuid
  type        String   @db.VarChar(50) // weekly, monthly
  periodStart DateTime @map("period_start") @db.Date
  periodEnd   DateTime @map("period_end") @db.Date
  content     String   @db.Text
  sections    Json?
  createdAt   DateTime @default(now()) @map("created_at")

  // Relations
  patient     Patient  @relation(fields: [patientId], references: [id])

  @@map("ai_reports")
}

// =============================================================================
// CONTENT & EDUCATION
// =============================================================================

model Content {
  id           String   @id @default(uuid()) @db.Uuid
  type         String   @db.VarChar(50) // video, article, guide
  title        String   @db.VarChar(255)
  description  String?  @db.Text
  contentUrl   String?  @map("content_url") @db.VarChar(500) // for videos
  contentBody  String?  @map("content_body") @db.Text // for articles
  thumbnailUrl String?  @map("thumbnail_url") @db.VarChar(500)
  tags         String[]
  categoryIds  String[] @map("category_ids") @db.Uuid // related substance categories
  substanceIds String[] @map("substance_ids") @db.Uuid // related substances
  isPublished  Boolean  @default(false) @map("is_published")
  createdAt    DateTime @default(now()) @map("created_at")

  @@map("content")
}

// =============================================================================
// AUDIT & LOGGING
// =============================================================================

model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  patientId  String?  @map("patient_id") @db.Uuid
  action     String   @db.VarChar(100)
  tableName  String?  @map("table_name") @db.VarChar(100)
  recordId   String?  @map("record_id") @db.Uuid
  oldValues  Json?    @map("old_values")
  newValues  Json?    @map("new_values")
  ipAddress  String?  @map("ip_address") @db.VarChar(45)
  userAgent  String?  @map("user_agent") @db.Text
  createdAt  DateTime @default(now()) @map("created_at")

  @@map("audit_logs")
}
