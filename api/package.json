{
  "name": "logmydose-api",
  "version": "1.0.0",
  "description": "LogMyDose API - Peptide therapy tracking platform",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "db:generate": "npm run db:generate -w @logmydose/shared",
    "db:push": "npm run db:push -w @logmydose/shared",
    "db:migrate": "npm run db:migrate -w @logmydose/shared",
    "db:migrate:prod": "npm run db:migrate:prod -w @logmydose/shared",
    "db:seed": "npm run db:seed -w @logmydose/shared",
    "db:studio": "npm run db:studio -w @logmydose/shared",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.981.0",
    "@aws-sdk/s3-request-presigner": "^3.981.0",
    "@logmydose/shared": "*",
    "@prisma/adapter-pg": "^7.3.0",
    "bcryptjs": "^3.0.3",
    "bullmq": "^5.67.2",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.2.3",
    "express": "^5.2.1",
    "express-rate-limit": "^8.2.1",
    "helmet": "^8.0.0",
    "ioredis": "^5.9.2",
    "jsonwebtoken": "^9.0.2",
    "pdfkit": "^0.17.2",
    "stripe": "^20.3.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.19.7",
    "@types/pdfkit": "^0.17.4",
    "@types/pg": "^8.16.0",
    "eslint": "^9.17.0",
    "globals": "^17.3.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.54.0"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
